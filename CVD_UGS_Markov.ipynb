      "source": [
        "## 4. Markov traces"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 69,
      "id": "bf2c1880",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
