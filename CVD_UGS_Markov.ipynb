      "source": [
        "df_or_psd = pd.DataFrame({\n",
        "    \"scenario\": [\"0 PSDs\", \"1 PSD\", \"2 PSDs\", \"3 PSDs\", \"4-5 PSDs\"],\n",
        "    \"OR\": [1.00, 1.08, 1.13, 1.41, 1.44],\n",
        "    \"CI_low\": [1.00, 1.02, 1.04, 1.26, 1.24],\n",
        "    \"CI_high\": [1.00, 1.15, 1.24, 1.57, 1.66],\n",
        "})\n",
        "df_or_psd"
      ]
