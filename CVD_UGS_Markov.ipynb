            "text/plain": [
              "{'prop_low': np.float64(0.2510970830497735),\n",
              " 'prop_med': np.float64(0.2969837653898029),\n",
              " 'prop_high': np.float64(0.45191915156042356)}"
            ]
          },
          "metadata": {},
