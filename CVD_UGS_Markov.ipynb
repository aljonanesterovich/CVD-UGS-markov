              "summary": "{\n  \"name\": \"preview_df\",\n  \"rows\": 5,\n  \"fields\": [\n    {\n      \"column\": \"scenario\",\n      \"properties\": {\n        \"dtype\": \"string\",\n        \"num_unique_values\": 5,\n        \"samples\": [\n          \"1 PSD\",\n          \"4-5 PSDs\",\n          \"2 PSDs\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"adj_MI\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.006335804243388583,\n        \"min\": 0.9858089250500948,\n        \"max\": 0.9999999999999999,\n        \"num_unique_values\": 5,\n        \"samples\": [\n          0.9968215962547269,\n          0.9858089250500948,\n          0.9949962198859992\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"adj_stroke\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.005505888600660445,\n        \"min\": 0.9876677885243481,\n        \"max\": 1.0,\n        \"num_unique_values\": 5,\n        \"samples\": [\n          0.9972379296649424,\n          0.9876677885243481,\n          0.9956516560752903\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"adj_mort\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.01951703353765752,\n        \"min\": 0.9564363406350451,\n        \"max\": 1.0,\n        \"num_unique_values\": 5,\n        \"samples\": [\n          0.9905878248095938,\n          0.9564363406350451,\n          0.9850987190483482\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"
